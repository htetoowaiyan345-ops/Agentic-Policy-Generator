# Backend service
API_HOST=127.0.0.1
API_PORT=8765
API_BASE_URL=http://127.0.0.1:8765

# Upload cap
MAX_UPLOAD_MB=50

# Database paths (relative to backend/)
DB_PATH=./data/policy_history.db
TEST_DB_PATH=./data/policy_history_e2e.db

# E2E test defaults
TEST_ACTOR=test-author
TEST_REVIEWER=test-reviewer

# Gate for the slow end-to-end happy-path test (0 = skip, 1 = run)
RUN_E2E=0

# RAG-side label-chunking contract:
#   1 (default) = every section-heading label occurrence is its own paragraph
#       boundary at the RAG layer (fixes slot-bleed on dense single-paragraph
#       sources like Earthquake PDF — slot 12/14 History isolation)
#   0 = opt-out: legacy behaviour, every paragraph is one unit
AGENTIC_POLICY_RAG_LABEL_CHUNKING=1

# RAG-Hybrid retrieval tunables (defaults preserve prior behavior)
RAG_TIMEOUT_SECONDS=120
RAG_ALPHA=0.7
RAG_TOP_K_PER_BACKEND=5
RAG_RERANK_POOL=5
RAG_MIN_CONFIDENCE=0.05

# Brain slot capacity
BRAIN_REASON_CAPACITY=100

# Optional: real secrets should live in a real .env (gitignored), not here.
# OPENAI_API_KEY=
# SMTP_HOST=
# SMTP_PORT=
